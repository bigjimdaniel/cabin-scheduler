[Unit]
Description=Cabin Scheduler Gunicorn
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/opt/cabin-scheduler
EnvironmentFile=/opt/cabin-scheduler/.env
ExecStart=/opt/cabin-scheduler/.venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8000 --workers 3
Restart=always

[Install]
WantedBy=multi-user.target
