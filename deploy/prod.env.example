DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=YOUR_PUBLIC_IP
DJANGO_CSRF_TRUSTED_ORIGINS=http://YOUR_PUBLIC_IP
DJANGO_DEBUG=false
DJANGO_SETTINGS_MODULE=config.settings_prod
DJANGO_USE_POSTGRES=true
DJANGO_ENABLE_HTTPS=false
DJANGO_SECURE_COOKIES=false
DJANGO_HSTS_SECONDS=0
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
POSTGRES_DB=cabin_scheduler
POSTGRES_USER=cabin_scheduler
POSTGRES_PASSWORD=replace-with-a-strong-db-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Switch to django.core.mail.backends.smtp.EmailBackend and fill these in to send invites.
DEFAULT_FROM_EMAIL=Daniel Dream <cabin@example.com>
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
SITE_URL=https://your-domain.com
DOCUMENT_MAX_UPLOAD_BYTES=20971520
CAROUSEL_MAX_UPLOAD_BYTES=10485760
PUBLIC_SERVER_NAME=_
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=replace-with-a-strong-admin-password
